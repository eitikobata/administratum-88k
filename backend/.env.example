# PostgreSQL connection string.
# Local dev: point at the Postgres container from infra/docker-compose.dev.yml
# Production: point at the shared Postgres service on the VPS, using a
# database created just for this project (e.g. administratum88k).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/administratum88k?schema=public"

# Redis connection used by BullMQ.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3000

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:3001

# How long (in hours) a petition has to be decided before the expiry sweep
# marks it EXPIRED.
PETITION_DEADLINE_HOURS=72

# How often (in ms) the expiry sweep job runs. Kept low by default so it's
# easy to see EXPIRED petitions happen during local testing; raise this in
# production (e.g. 300000 = 5 min).
EXPIRY_SWEEP_INTERVAL_MS=30000
