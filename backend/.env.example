# PostgreSQL connection string.
# Local dev: point at the Postgres container from infra/docker-compose.dev.yml
# Production: point at the shared Postgres service on the VPS, using a
# database created just for this project (e.g. administratum88k).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/administratum88k?schema=public"

# Redis connection used by BullMQ.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3000

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:3001

# How long (in hours) a petition has to be decided before the expiry sweep
# marks it EXPIRED.
PETITION_DEADLINE_HOURS=72

# How often (in ms) the expiry sweep job runs. Kept low by default so it's
# easy to see EXPIRED petitions happen during local testing; raise this in
# production (e.g. 300000 = 5 min).
EXPIRY_SWEEP_INTERVAL_MS=30000

# Background simulator: keeps the public demo visibly "alive" by filing and
# deciding a handful of fictional petitions on its own, and quietly
# cleaning up the closed-out ones once they're old. Off by default so a
# plain local checkout never gets synthetic noise unless you opt in.
# Real, visitor-filed petitions are NEVER touched by any of this.
SIMULATOR_ENABLED=false
SIMULATOR_TICK_INTERVAL_MS=900000
SIMULATOR_CLEANUP_INTERVAL_MS=86400000
SIMULATOR_CLEANUP_MAX_AGE_DAYS=3
